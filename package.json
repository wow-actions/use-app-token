{
  "name": "use-app-token",
  "version": "2.1.2",
  "description": "Run GitHub Actions as a GitHub App by using the app's authentication token",
  "main": "dist/index.js",
  "files": [
    "dist",
    "action.yml"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "eslint 'src/**/*.{js,ts}?(x)' --fix",
    "build": "ncc build src/index.ts --minify --v8-cache",
    "prebuild": "npm run lint && npm run clean",
    "prepare": "is-ci || husky install .husky"
  },
  "lint-staged": {
    "**/*.{js,jsx,tsx,ts,less,md,json}": [
      "pretty-quick — staged"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "license": "MIT",
  "author": {
    "name": "bubkoo",
    "email": "bubkoo.wy@gmail.com"
  },
  "contributors": [],
  "repository": "https://github.com/wow-actions/use-app-token",
  "dependencies": {
    "@actions/core": "^1.10.0",
    "@actions/github": "^9.1.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/core": "^7.0.6",
    "is-base64": "^1.1.0",
    "libsodium-wrappers": "0.8.4"
  },
  "devDependencies": {
    "@bubkoo/commitlint-config": "^1.2.2",
    "@bubkoo/eslint-config": "^1.5.1",
    "@bubkoo/tsconfig": "^1.2.4",
    "@types/is-base64": "^1.1.3",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^18.19.130",
    "@vercel/ncc": "^0.38.4",
    "eslint": "^8.28.0",
    "husky": "^8.0.2",
    "is-ci": "^3.0.1",
    "prettier": "^2.7.1",
    "pretty-quick": "^3.1.3",
    "rimraf": "^3.0.2",
    "typescript": "^4.9.3"
  }
}
